{
    "builds": [
        {
            "src": "3.my-react-app/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/3.my-react-app/index.html"
        }
    ]
}